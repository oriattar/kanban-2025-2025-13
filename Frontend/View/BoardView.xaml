<Window x:Class="Frontend.View.BoardView"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="BoardView" Height="450" Width="800">
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">

            <Button DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0">
                <materialDesign:PackIcon Kind="Backburger"
                                 Height="25"
                                 Width="25"
                                 VerticalAlignment="Center"
                                 Foreground="Black"/>
            </Button>
            
            <TextBlock Text="board name" 
                       FontSize="25" 
                       VerticalAlignment="Center" 
                       DockPanel.Dock="Left"
                       FontWeight="Bold"/>


            <Button DockPanel.Dock="Right" 
        BorderThickness="2" 
                    Background="White"

        BorderBrush="Black"
        Padding="6,2" 
        ToolTip="פרטים"
        HorizontalAlignment="Right"
        Cursor="Hand"
        Margin="5"
                >
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3">
                    <TextBlock Text="פרטים" 
                   FontSize="14"
                   FontWeight="Bold"   
                   Foreground="Black"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
        <materialDesign:PackIcon Kind="DotsVertical"
                                 Height="18"
                                 Width="18"
                                 Foreground="Black"
                                 VerticalAlignment="Center"/>
    </StackPanel>
                
                
            </Button>

        </DockPanel>
        <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Center" Margin="5" Width="760" >
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <Grid Margin="5" VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Backlog" FontWeight="Bold" Grid.Column="0" VerticalAlignment="Center"/>

                        <materialDesign:PackIcon Kind="NotePlusOutline" Width="20" Height="20" Grid.Column="1" VerticalAlignment="Center"/>
                    </Grid>
                    <Separator Margin="5,0" Height="2" Background="Gray"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="10" Grid.Row="0" Margin="0,0,0,5"/>
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" Orientation="Vertical">
                                                <TextBlock Text="{Binding AssignedTo}" FontSize="8" Foreground="Gray"/>
                                                <TextBlock Text="{Binding DueDate}" FontSize="8" Foreground="Gray" Margin="0,4,0,0"/>
                                            </StackPanel>

                                            <Button Background="Transparent" BorderBrush="Transparent"  BorderThickness="0" Padding="0" Width="40" 
                            Height="30"  Grid.Column="1"  VerticalAlignment="Center" Margin="10,0,0,0"  Cursor="Hand">
                                                <materialDesign:PackIcon  Kind="ChevronRight"    Width="20"  Height="20"    Foreground="Black"    VerticalAlignment="Center"/>
                                            </Button>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="In progress" FontWeight="Bold" Margin="5"/>
                    <Separator Margin="5,0" Height="2" Background="Gray"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="10" Grid.Row="0" Margin="0,0,0,5"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding AssignedTo}" FontSize="8" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding DueDate}" FontSize="8" Foreground="Gray" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Button Background="Transparent" BorderBrush="Transparent"  BorderThickness="0" Padding="0" Width="40" 
        Height="30"  Grid.Column="1"  VerticalAlignment="Center" Margin="10,0,0,0"  Cursor="Hand">
                                                    <materialDesign:PackIcon  Kind="ChevronRight"    Width="20"  Height="20"    Foreground="Black"    VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <StackPanel>
                    <TextBlock Text="Done" FontWeight="Bold" Margin="5"/>
                    <Separator Margin="5,0" Height="2" Background="Gray"/>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">

                        <ItemsControl ItemsSource="{Binding Tasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontSize="10" Grid.Row="0" Margin="0,0,0,5"/>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding AssignedTo}" FontSize="8" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding DueDate}" FontSize="8" Foreground="Gray" Margin="0,4,0,0"/>
                                                </StackPanel>

                                                <Button Background="Transparent" BorderBrush="Transparent"  BorderThickness="0" Padding="0" Width="40" 
        Height="30"  Grid.Column="1"  VerticalAlignment="Center" Margin="10,0,0,0"  Cursor="Hand">
                                                    <materialDesign:PackIcon  Kind="ChevronRight"    Width="20"  Height="20"    Foreground="Black"    VerticalAlignment="Center"/>
                                                </Button>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>


                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</Window>
