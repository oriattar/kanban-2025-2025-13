<Window x:Class="Frontend.View.BoardView"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="BoardView" Height="688" Width="1025"
>
    <Grid Background="White" Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="5*"/>
            <RowDefinition Height="0.35*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">

            <Button DockPanel.Dock="Left" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,10,0" Click="Back_Click">
                <materialDesign:PackIcon Kind="Backburger"
                                 Height="25"
                                 Width="25"
                                 VerticalAlignment="Center"
                                 Foreground="Black"/>
            </Button>

            <TextBlock Text="{Binding BoardName}" 
                       FontSize="25" 
                       VerticalAlignment="Center" 
                       DockPanel.Dock="Left"
                       FontWeight="Bold"/>


            <Button DockPanel.Dock="Right" 
        BorderThickness="1" 
                    Background="White"

        BorderBrush="Black"
        Padding="6,2" 
        ToolTip="פרטים"
        HorizontalAlignment="Right"
        Cursor="Hand"
        Margin="0,0,7,0"
        Click="Details_click"
                >
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="3">
                    <TextBlock Text="פרטים" 
                   FontSize="14"
                   FontWeight="Bold"   
                   Foreground="Black"
                   VerticalAlignment="Center"
                   Margin="6,0,0,0"/>
        <materialDesign:PackIcon Kind="DotsVertical"
                                 Height="18"
                                 Width="18"
                                 Foreground="Black"
                                 VerticalAlignment="Center"/>
    </StackPanel>
                
                
            </Button>

        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="3" HorizontalAlignment="Stretch" Margin="5" >
            
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                        <Grid Margin="5" VerticalAlignment="Center" Grid.Column="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,5,0,0">
                            <TextBlock Text="Backlog" FontWeight="Bold" />
                            <TextBlock Text="{Binding Backlog_limit, Mode=OneWay}" FontSize="12" Foreground="Gray" HorizontalAlignment="Left" Width="100" Height="15"/>
                        </StackPanel>


                        <Button Width="20" Height="20" Grid.Column="1" VerticalAlignment="Center" Background="Transparent" Click="TaskCreation_Click">
                                <materialDesign:PackIcon Kind="NotePlusOutline" Width="15" Height="15"/>
                            </Button>
                        
                        
                    </Grid>
                    <Separator Margin="5,0" Height="2" Background="Gray" Grid.Row="1"/>

                        <ScrollViewer  VerticalScrollBarVisibility="Auto" Grid.Row="2">

                        <ItemsControl ItemsSource="{Binding Backlog}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}"
           TextWrapping="Wrap"
           FontSize="16"
           FontWeight="Bold"
           Grid.Row="0"
           Margin="0,0,0,5"/>

                                            
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding AssignedTo}" FontSize="12" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding CreationTime}" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DueDate}" FontSize="10" Foreground="Gray" Margin="0,4,0,0" FontWeight="Bold"/>
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Margin="0,20,0,0" >

                                                    <Button Width="30" Height="30"
                                                    Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    BorderThickness="0"
                                                    Padding="0"
                                                    Cursor="Hand"
                                                    Click="Edit_click"
                                                    ToolTip="Edit">
                                                        <materialDesign:PackIcon Kind="CircleEditOutline"
                                                         Width="18"
                                                         Height="18"
                                                         Foreground="Black"
                                                     VerticalAlignment="Center"
                                                     HorizontalAlignment="Center"/> 
                                                    </Button>

                                                    
                                                    <Button Width="30" Height="30"
                                                        Background="Transparent"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="0"
                                                        Click="TaskAdvance_Click"
                                                        Padding="0"
                                                        Margin="5,0,0,0"
                                                        Cursor="Hand"
                                                        ToolTip="Advance">
                                                        <materialDesign:PackIcon Kind="ChevronRight"
                                                         Width="20"
                                                         Height="20"
                                                         Foreground="Black"
                                                         VerticalAlignment="Center"
                                                         HorizontalAlignment="Center"/>     
                                                    </Button>

                                                </StackPanel>

                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </ScrollViewer>

                </Grid>

            </Border>
            
            
            
            
            
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Margin="7" Grid.Row="0">
                        <TextBlock Text="In Progress" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Inprogress_limit , Mode=OneWay}" FontSize="12" Foreground="Gray" HorizontalAlignment="Left" Width="100" Height="15"/>
                    </StackPanel>


                    <Separator Margin="5,0" Height="2" Background="Gray" Grid.Row="1"/>

                    <ScrollViewer  VerticalScrollBarVisibility="Auto" Grid.Row="2">

                        <ItemsControl ItemsSource="{Binding Inprogress}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}"
           TextWrapping="Wrap"
           FontSize="16"
           FontWeight="Bold"
           Grid.Row="0"
           Margin="0,0,0,5"/>

                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding AssignedTo}" FontSize="12" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding CreationTime}" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DueDate}" FontSize="10" Foreground="Gray" Margin="0,4,0,0" FontWeight="Bold"/>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Column="1" Margin="0,20,0,0" >

                                                    <Button Width="30" Height="30"
                                                                Background="Transparent"
                                                                BorderBrush="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Cursor="Hand"
                                                                Click="Edit_click"
                                                                ToolTip="Edit">
                                                        <materialDesign:PackIcon Kind="CircleEditOutline"
                                                                 Width="18"
                                                                 Height="18"
                                                                 Foreground="Black"
                                                             VerticalAlignment="Center"
                                                             HorizontalAlignment="Center"/>
                                                    </Button>


                                                    <Button Width="30" Height="30"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Click="TaskAdvance_Click"
                                                                        Margin="5,0,0,0"
                                                                        Cursor="Hand"
                                                                        ToolTip="Advance">
                                                        <materialDesign:PackIcon Kind="ChevronRight"
                                                                 Width="20"
                                                                 Height="20"
                                                                 Foreground="Black"
                                                                 VerticalAlignment="Center"
                                                                 HorizontalAlignment="Center"/>
                                                    </Button>

                                                </StackPanel>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
                
            <Border BorderBrush="Gray" BorderThickness="1" Margin="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>


                    <StackPanel Margin="7" Grid.Row="0">
                        <TextBlock Text="Done" FontWeight="Bold"/>
                        <TextBlock Text="{Binding Done_limit ,Mode=OneWay}" FontSize="12" Foreground="Gray" HorizontalAlignment="Left" Width="100" Height="15"/>
                    </StackPanel>
                    <Separator Margin="5,0" Height="2" Background="Gray" Grid.Row="1"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="2">

                        <ItemsControl ItemsSource="{Binding Done}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="1" Margin="5" Padding="8" CornerRadius="5" Background="White">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Text="{Binding Title}"
           TextWrapping="Wrap"
           FontSize="16"
           FontWeight="Bold"
           Grid.Row="0"
           Margin="0,0,0,5"/>


                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Column="0" Orientation="Vertical">
                                                    <TextBlock Text="{Binding AssignedTo}" FontSize="12" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding CreationTime}" FontSize="10" Foreground="Gray" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding DueDate}" FontSize="10" Foreground="Gray" Margin="0,4,0,0" FontWeight="Bold"/>
                                                </StackPanel>


                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </UniformGrid>
        <Label Content="{Binding Path=ErrorMsg ,Mode=OneWay}" Grid.Row="2" HorizontalAlignment="Left" Width="500" Margin="5" Height="35" FontSize="12" FontWeight="SemiBold" Foreground="Red"
        ></Label>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,07,0">

            <Button Content="Limit"
            Height="25"
                 Margin="5"
                    Width="70"
            VerticalAlignment="Center"
            FontWeight="SemiBold" Click="Limit_Click" />

            
            
                <TextBox Width="150"
                 Height="25"
                 Margin="5"
                 HorizontalAlignment="Right"
                 FontSize="14"
                 Text="{Binding Path=LimitText,Mode=OneWayToSource}"></TextBox>



            <ComboBox SelectedItem ="{Binding Path=SelectedCol,Mode=OneWayToSource}" Width="150"                  Margin="0"

                  Height="25"
                  SelectedIndex="0">
                    <ComboBoxItem Content="Backlog" />
                    <ComboBoxItem Content="In Progress" />
                    <ComboBoxItem Content="Done"/>
                </ComboBox>

        </StackPanel>
    </Grid>
    
</Window>
