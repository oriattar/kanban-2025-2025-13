<Window x:Class="Frontend.View.BoardDetails"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="BoardDetails" Height="405"
        Width="720">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="board name"
                   FontSize="25"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="10"
                   Grid.Row="0"/>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Padding="10">
            <StackPanel>
                <TextBlock Text="Board Members" FontSize="17" FontWeight="Bold" Margin="0,0,0,10"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="aaaa@gmail.com" FontWeight="Bold"/>
                            <TextBlock Text="  (Manager)" Foreground="Gray" Margin="5,0,0,0"/>
                        </StackPanel>

                        <ItemsControl>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="5">
                                        <TextBlock Text="{Binding}" FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="10">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="EmailTextBox" Width="300" Height="25" Margin="0,0,20,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Text="Enter email"/>
                <Button Width="140" Height="25" Margin="0" Cursor="Hand" Click="AddMember_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20"  Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Member" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="Black"
                       FontSize="12"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"
                       Text="Invalid email address"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="UsernameTextBox" Width="300" Height="25" Margin="0,0,20,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Text="Enter email"/>
                <Button Width="140" Height="25" Margin="0" Cursor="Hand" Click="AddUsername_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountSwitch" Width="20" Height="20" Margin="0,0,5,0" />
                        <TextBlock Text="Change Owner" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="UsernameErrorTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="Collapsed"
                       Text="Invalid username"/>
        </StackPanel>

        <Button Grid.Row="3"
                Margin="0,1,0,1"
                Height="30"
                HorizontalAlignment="Center"
                Width="250"
                Background="LightGray"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Leave Board" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
