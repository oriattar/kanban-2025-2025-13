<Window x:Class="Frontend.View.BoardDetails"
                     xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="BoardDetails"  Height="688" Width="1025">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

            <Button Background="Transparent" BorderThickness="0" Padding="0" Click="Back_ToBoardView" HorizontalAlignment="Left" Width="25">
            <materialDesign:PackIcon Kind="Backburger"
                     Height="25"
                     Width="25"
                     VerticalAlignment="Center"

                     Foreground="Black"/>
        </Button>
        <TextBlock Text="{Binding Path=BoardName}"
                   FontSize="25"
                   FontWeight="Bold"
                   Margin="20,10,0,10"
                   Grid.Row="0" Width="600"/>
        </StackPanel>

        <Border Grid.Row="1" BorderBrush="Gray" BorderThickness="1" CornerRadius="5" Height="400" Padding="10" Margin="0,4,0,2" Grid.RowSpan="2">
            <StackPanel>
                <TextBlock Text="Board Members" FontSize="20" FontWeight="Bold" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="{Binding Path=BoardOwner,Mode=OneWay}" FontWeight="Bold" FontSize="16"/>
                    <TextBlock Text="  (Manager)" Foreground="Gray" Margin="5,0,0,0" FontSize="16"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Height="120">
                    <StackPanel>


                        <ItemsControl  ItemsSource="{Binding Path=ActiveUsers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="LightGray" BorderThickness="0,1,0,1" Padding="5">
                                        <TextBlock Text="{Binding Email}" FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" HorizontalAlignment="Center" Margin="0,10,0,10" Width="460">

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBox x:Name="EmailTextBox" Width="300" Height="25" Margin="0,0,20,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Text="{Binding Path=AddMemberText, Mode=OneWayToSource}"/>
                <Button Width="140" Height="25" Margin="0" Cursor="Hand" Click="AddMember_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountPlus" Width="20" Height="20"  Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Add Member" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="ErrorTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="Black"
                       FontSize="12"
                       Margin="0,0,0,10"
                       Visibility="Collapsed"
                       Text="Invalid email address"/>

            <StackPanel Orientation="Horizontal">
                <TextBox x:Name="UsernameTextBox" Width="300" Height="25" Margin="0,0,20,0"
                         VerticalContentAlignment="Center"
                         FontSize="14"
                         Text="{Binding Path=ChangeOwnerText , Mode=OneWayToSource}"/>
                <Button Width="140" Height="25" Margin="0" Cursor="Hand" Click="ChangeOwner_Click">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="AccountSwitch" Width="20" Height="20" Margin="0,0,5,0" />
                        <TextBlock Text="Change Owner" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <TextBlock x:Name="UsernameErrorTextBlock"
                       HorizontalAlignment="Center"
                       Foreground="Red"
                       FontSize="12"
                       Margin="0,5,0,0"
                       Visibility="Collapsed"
                       Text="Invalid username"/>
        </StackPanel>

        <Button Grid.Row="4"
                Margin="0,10,0,10"
                HorizontalAlignment="Center"
                Width="250"
                Background="LightGray"
                Click="LeaveBoard_Click"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ExitToApp" Width="20" Height="20" Margin="0,0,5,0" VerticalAlignment="Center"/>
                <TextBlock Text="Leave Board" VerticalAlignment="Center" FontSize="14"/>
            </StackPanel>
        </Button>

        <Label Content="{Binding ErrorMsg}" FontSize="14" Grid.Row="5" Width="600" HorizontalAlignment="Left"  FontWeight="Bold">
            <Label.Style>
                <Style TargetType="Label">
                    <Setter Property="Foreground" Value="Red"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Status}" Value="True">
                            <Setter Property="Foreground" Value="Green"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Label.Style>
        </Label>
    </Grid>
</Window>
