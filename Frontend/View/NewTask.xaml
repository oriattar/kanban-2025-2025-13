<Window x:Class="Frontend.View.NewTask"
                             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"

        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
            Title="NewTask" Height="420" Width="540">
<Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Add/Edit Task"
                   FontSize="20"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,0" >
            <TextBlock Text="Task Description:" FontWeight="SemiBold"/>
            <TextBox x:Name="TaskDescriptionTextBox" Height="80" Margin="0,5,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Assign To:" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBox x:Name="assign" Height="30" Width="410" TextWrapping="Wrap" VerticalAlignment="Center"/>
                <CheckBox x:Name="UnassignCheckBox" Content="Unassign" Margin="15,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="ErrorTextBlock"
           HorizontalAlignment="Center"
           Foreground="Black"
           FontSize="12"
           Margin="0,0,0,10"
           Visibility="Collapsed"
           Text="Invalid email address"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Due Date:" FontWeight="SemiBold"/>
            <DatePicker x:Name="DueDatePicker" Height="30" Margin="0,5,0,0" Padding="5"/>
        </StackPanel>

        <!-- Add Task Button -->
        <Button Grid.Row="4"
                Height="35"
                Width="120"
                HorizontalAlignment="Center"
                Margin="0,20,0,0"
                Foreground="Black"
                Click="AddTask_Click">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="NotePlus" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <TextBlock Text="Add Task" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
