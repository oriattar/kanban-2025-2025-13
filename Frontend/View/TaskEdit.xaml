<Window x:Class="Frontend.View.TaskEdit"
          xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"


        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Frontend.View"
        mc:Ignorable="d"
        Title="TaskEdit" Height="400" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>

        </Grid.RowDefinitions>

        <TextBlock Text="Edit Task"
                   FontSize="25"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,5"
                   Grid.Row="0"/>

        <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Title:" FontWeight="SemiBold"/>
            <TextBox x:Name="Title"
             Height="30"
             Margin="0,5,0,0"
             TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Task Description:" FontWeight="SemiBold"/>
            <TextBox x:Name="TaskDescriptionTextBox"
                     Height="30"
                     Margin="0,5,0,0"
                     TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Assign To:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <TextBox x:Name="AssignTextBox"
                   Height="30"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center"/>
            <TextBlock x:Name="ErrorTextBlock"
            Foreground="Black"
            FontSize="12"
            Margin=" 5,0,0,0"
           Visibility="Collapsed"

                       
            Text="Invalid email address"/>

        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock Text="Due Date:" FontWeight="SemiBold"/>
            <DatePicker x:Name="DueDatePicker"
                        Height="30"
                        Margin="0,5,0,0"
                        Padding="5"/>
        </StackPanel>

      

        <Button Grid.Row="5"
                Height="40"
                Width="140"
                Margin="0,20,0,0"
                HorizontalAlignment="Center"
                Click="SaveTask_Click"
                Foreground="Black"
                Cursor="Hand">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ContentSave" Width="20" Height="20" Margin="0,0,5,0"/>
                <TextBlock Text="Save Task" VerticalAlignment="Center"/>
            </StackPanel>
        </Button>
    </Grid>
</Window>
